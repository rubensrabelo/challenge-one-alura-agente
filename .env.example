# Alura Agente - Configurações Gerais de Ambiente (Modelo)
# Copie este arquivo para um arquivo chamado `.env` e preencha com seus dados reais.

# Token de Acesso de leitura gratuito do Hugging Face (Obrigatório)
HUGGINGFACEHUB_API_TOKEN=hf_seu_token_aqui

# Endereço de API para o Build do Frontend (Vite)
# Para rodar no Docker local: http://localhost
# Para rodar na produção (Vercel): https://onrender.com
VITE_API_BASE_URL=http://localhost

# Configurações do Servidor de Produção (Opcional - Usado internamente)
PORT=8000
HOST=0.0.0.0
